JUSTTCG_API_KEY=your_justtcg_api_key_here
JUSTTCG_BASE_URL=https://api.justtcg.com
PHRONESIS_JUSTTCG_WATCH_ENRICHMENT=DISABLED
PHRONESIS_JUSTTCG_WATCH_REQUEST_BUDGET=10
EBAY_BROWSE_ACCESS_TOKEN=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_BROWSE_BASE_URL=https://api.ebay.com
EBAY_IDENTITY_BASE_URL=https://api.ebay.com
CARDTRADER_API_TOKEN=
CARDTRADER_BASE_URL=https://api.cardtrader.com
PROVIDER_MODE=LIVE
PROVIDER_RECORD_FIXTURES=false

# PkmnPrices sealed is a Pro/Business endpoint. Phronesis spends at most 100
# credits per UTC day, exclusively on newest-release-first sealed records.
PKMNPRICES_API_KEY=

# PSA public certificate API bearer token. Never prefix this with NEXT_PUBLIC_.
PSA_API_TOKEN=

# Optional owner-managed native Google Sheet used as the Event Inventory authoring template.
# Live event selling never depends on this URL after the exported CSV is imported.
NEXT_PUBLIC_EVENT_INVENTORY_TEMPLATE_URL=

# Invite-only Phronesis identity. Keep DISABLED until migration, OAuth credentials,
# base URL, session secret, and the initial owner invitation are all ready.
PHRONESIS_AUTH_MODE=DISABLED
PHRONESIS_AUTH_DB_PATH=.data/phronesis-auth.sqlite
PHRONESIS_CURATED_ARTWORK_PATH=.data/artwork-curated
BETTER_AUTH_URL=https://your-private-phronesis-host.example
BETTER_AUTH_SECRET=generate_and_store_outside_git
GITHUB_CLIENT_ID=your_private_github_oauth_client_id
GITHUB_CLIENT_SECRET=store_outside_git

# Keep DISABLED until restricted-public DNS, tunnel, gateway, and end-to-end
# activation checks pass. The configured origin may remain a trusted auth origin
# while disabled; owner Sign Up invites will continue using the private app URL.
PHRONESIS_RESTRICTED_PUBLIC_ORIGIN=https://access.phronesis.com
PHRONESIS_RESTRICTED_PUBLIC_MODE=DISABLED
