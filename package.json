{
  "name": "phronesis-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-phronesis.mjs dev",
    "build": "next build",
    "start": "node scripts/start-phronesis.mjs start",
    "evidence:web": "JARVIS_RUNTIME_EVIDENCE=1 next dev --webpack --hostname 127.0.0.1",
    "evidence:preflight": "python3 tests/jarvis_runtime_evidence.py --preflight",
    "evidence:validate": "python3 tests/jarvis_runtime_evidence.py --validate-evidence",
    "evidence:validator-test": "python3 -m unittest discover -s tests -t tests -p jarvis_runtime_evidence_test.py -v",
    "lint": "eslint",
    "test": "node --import ./tests/register-test-hooks.mjs --test tests/*.test.ts",
    "pricing:import": "node --import ./tests/register-test-hooks.mjs scripts/import-pricing-export.ts",
    "pricing:catalog-import": "node --import ./tests/register-test-hooks.mjs scripts/import-tcgplayer-catalog.ts",
    "pricing:sync": "node --import ./tests/register-test-hooks.mjs scripts/watch-pricing-catalogues.ts --once",
    "pricing:watch": "node --import ./tests/register-test-hooks.mjs scripts/watch-pricing-catalogues.ts",
    "artwork:warm": "node --import ./tests/register-test-hooks.mjs scripts/warm-artwork.ts",
    "artwork:community": "node --import ./tests/register-test-hooks.mjs scripts/fill-community-pokemon-artwork.ts",
    "artwork:review-stage": "node --import ./tests/register-test-hooks.mjs scripts/stage-sealed-artwork-review.ts",
    "artwork:review-assist": "node --import ./tests/register-test-hooks.mjs scripts/assist-sealed-artwork-review.ts",
    "sealed:sync": "node --import ./tests/register-test-hooks.mjs scripts/sync-pkmnprices-sealed.ts",
    "pricecharting:import": "node --import ./tests/register-test-hooks.mjs scripts/import-pricecharting-csv.ts",
    "pricecharting:sync": "node --import ./tests/register-test-hooks.mjs scripts/sync-pricecharting-daily.ts",
    "pricecharting:watch": "node --import ./tests/register-test-hooks.mjs scripts/sync-pricecharting-daily.ts --watch",
    "auth:migrate": "node --import ./tests/register-test-hooks.mjs scripts/migrate-auth.ts",
    "auth:bootstrap-owner": "node --import ./tests/register-test-hooks.mjs scripts/bootstrap-owner.ts",
    "watchlists:claim-legacy": "node --import ./tests/register-test-hooks.mjs scripts/claim-legacy-watchlists.ts",
    "ligamagic:profile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ligamagic-export.ts profile",
    "ligamagic:pilot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ligamagic-export.ts pilot",
    "ligamagic:dry-run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ligamagic-export.ts dry-run",
    "regional:crosswalk": "node --import ./tests/register-test-hooks.mjs scripts/build-regional-crosswalk.ts",
    "review:phone": "node scripts/start-phronesis.mjs dev --hostname 127.0.0.1 --port 3100",
    "review:phone:status": "node scripts/private-review-status.mjs"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "justtcg-js": "^0.2.1",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
