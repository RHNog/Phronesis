{
  "name": "phronesis-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "evidence:web": "JARVIS_RUNTIME_EVIDENCE=1 next dev --webpack --hostname 127.0.0.1",
    "evidence:preflight": "python3 tests/jarvis_runtime_evidence.py --preflight",
    "evidence:validate": "python3 tests/jarvis_runtime_evidence.py --validate-evidence",
    "evidence:validator-test": "python3 -m unittest discover -s tests -t tests -p jarvis_runtime_evidence_test.py -v",
    "lint": "eslint",
    "test": "node --import ./tests/register-test-hooks.mjs --test tests/*.test.ts",
    "pricing:import": "node --import ./tests/register-test-hooks.mjs scripts/import-pricing-export.ts"
  },
  "dependencies": {
    "justtcg-js": "^0.2.1",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
